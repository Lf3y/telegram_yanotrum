BOT_TOKEN=
OWNER_CHAT_ID=
PORT=3001
FRONTEND_URL=http://localhost:5173
ADMIN_TOKEN=

# --- Telegram на Render (нет 409 от второго getUpdates) ---
# На Web Service Render есть RENDER_EXTERNAL_URL — тогда бот ставит webhook и НЕ использует polling.
# Если крутишь этот же BOT_TOKEN локально с polling — будет конфликт: останови локальный бэкенд
# или временно задай TELEGRAM_FORCE_POLLING=true только на одном инстансе.
#TELEGRAM_FORCE_POLLING=false
# Свой секрет в пути webhook (необязательно — иначе считается от BOT_TOKEN):
#TELEGRAM_WEBHOOK_SECRET=

# Если Render не выставил RENDER_EXTERNAL_URL, укажи публичный URL бэкенда:
#PUBLIC_BASE_URL=https://xxx.onrender.com
# PostgreSQL на Render или своём сервере (если пусто — используется SQLite shop.db).
# После создания БД на Render используй Internal Database URL или External.
#DATABASE_URL=postgresql://user:pass@host/dbname

# Для некоторых локальных/SaaS Postgres без TLS: DATABASE_SSL=false
#DATABASE_SSL=false
